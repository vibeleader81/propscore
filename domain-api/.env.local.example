# domain-api/.env.local — copy this to .env.local and fill in your keys

# Domain.com.au API (OAuth2 client credentials)
# Create at: https://developer.domain.com.au/
DOMAIN_CLIENT_ID=your_domain_client_id
DOMAIN_CLIENT_SECRET=your_domain_client_secret

# Google Maps Platform
# Enable: Geocoding API, Places API, Roads API, Distance Matrix API, Street View API
# Create at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# PropTechData (suburb growth statistics)
# https://www.proptechdata.com.au/
PROPTECHDATA_API_KEY=your_proptechdata_api_key

# Anthropic (used by evaluateProperty.ts)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: verbose logging
# DEBUG=true
